{
  "name": "ai-session-hub",
  "version": "0.5.0",
  "description": "主机级 AI 会话总览与跳转:TUI 一览 pi/Claude/opencode 的运行中与历史会话 —— 聚焦窗口、接管终端、分屏继续(拓展提供)、删除会话(入系统回收站)",
  "type": "module",
  "bin": {
    "ais": "./src/cli.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "list": "node src/cli.ts list",
    "doctor": "node src/cli.ts doctor",
    "tui": "node src/cli.ts",
    "panes": "node -e \"import('tui-panes').then(()=>console.log('tui-panes 可用')).catch(e=>console.log('未安装:', e.message))\"",
    "dev:link": "npm install --no-save --no-package-lock"
  },
  "keywords": [
    "ai",
    "session-manager",
    "tui",
    "windows-terminal",
    "uiautomation"
  ],
  "author": "Zzz210s",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zzz210s/ai-session-hub.git"
  },
  "optionalDependencies": {
    "tui-panes": "github:Zzz210s/tui-panes"
  }
}
